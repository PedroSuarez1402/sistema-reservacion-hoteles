# =================================================================
# 📦 BOOKING SERVICE — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# =================================================================
# USO (en máquinas nuevas después de git clone):
#   1) Copiar este archivo a uno llamado ".env" en la MISMA carpeta:
#        cp .env.example .env          # Linux/Mac
#        copy .env.example .env        # Windows PowerShell
#   2) Editar .env y reemplazar placeholders (DB_PASSWORD, JWT_SECRET, etc.).
#
#   ⚠️  NUNCA subas el .env REAL a Git (lo cubre services/*/.env en .gitignore).
#      Esta plantilla (.env.example) SÍ se sube, para que el equipo tenga las
#      variables documentadas.

# ================================================
# CONFIGURACIÓN DEL SERVIDOR
# ================================================
# Puerto en el que escuchará la API REST de usuarios/reservaciones
PORT=4002

# Entorno de ejecución: development | production | test
NODE_ENV=development

# URL pública del frontend (CORS whitelist)
FRONTEND_URL=http://localhost:3000

# URL pública de ESTE microservicio (referencia / debug, no obligatoria)
BOOKING_SERVICE_URL=http://localhost:4002

# ================================================
# BASE DE DATOS (MySQL — Sequelize)
# ================================================
DB_NAME=sistema-reservas
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
DB_SSL=false

# ================================================
# POOL DE CONEXIONES DE BD
# ================================================
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ================================================
# AUTENTICACIÓN JWT
# ================================================
# Generar clave segura en producción:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=secret_key_change_in_production
JWT_EXPIRES_IN=24h

# ================================================
# HASHING DE CONTRASEÑAS (BCRYPT)
# ================================================
BCRYPT_SALT_ROUNDS=10

# ================================================
# COMUNICACIÓN SINCRÓNICA HTTP (REST)
# ================================================
# Booking consulta el catálogo habitaciones EN ESTA URL para calcular el
# precio_total automáticamente cuando el cliente no lo envía en el body.
ROOM_SERVICE_URL=http://localhost:4001/api
# Tiempo máximo (ms) de espera de respuesta de room-service antes de abortar.
ROOM_SERVICE_TIMEOUT_MS=5000

# ================================================
# COMUNICACIÓN ASÍNCRONA — MESSAGE BROKER (Pub/Sub GoF)
# ================================================
# Booking PUBLICA el evento "RESERVA_CREADA" al broker, tras guardar la reserva.
# El broker (:4003) despacha el evento a TODOS los suscriptores registrados
# (room-service, audit, email, etc.) — de forma fire-and-forget.
BROKER_URL=http://localhost:4003

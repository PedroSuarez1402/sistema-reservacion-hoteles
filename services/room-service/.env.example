# ================================================
# CONFIGURACIÓN DEL SERVIDOR
# ================================================

# Puerto en el que escuchará la API REST
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# URL pública del frontend (para configuración de CORS)
FRONTEND_URL=http://localhost:3001

# ================================================
# BASE DE DATOS (MySQL)
# ================================================

# Nombre de la base de datos
DB_NAME=sistema-reservas

# Usuario de MySQL
DB_USER=root

# Contraseña de MySQL
DB_PASSWORD=tu_contraseña_mysql

# Host del servidor MySQL
DB_HOST=localhost

# Puerto del servidor MySQL (por defecto 3306)
DB_PORT=3306

# Dialecto de Sequelize (dejar como mysql)
DB_DIALECT=mysql

# Habilitar SSL para BD (útil en producción/planetscale/etc): true | false
DB_SSL=false

# ================================================
# POOL DE CONEXIONES DE BD
# ================================================

# Número máximo de conexiones en el pool
DB_POOL_MAX=5

# Número mínimo de conexiones en el pool
DB_POOL_MIN=0

# Tiempo máximo (ms) para adquirir una conexión del pool
DB_POOL_ACQUIRE=30000

# Tiempo máximo (ms) de inactividad antes de liberar una conexión
DB_POOL_IDLE=10000

# ================================================
# AUTENTICACIÓN JWT
# ================================================

# Clave secreta para firmar tokens JWT
# IMPORTANTE: En producción usa una cadena larga y aleatoria.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=secret_key_change_in_production

# Tiempo de expiración de los tokens JWT (ej: 24h, 7d, 30m)
JWT_EXPIRES_IN=24h

# ================================================
# HASHING DE CONTRASEÑAS (BCRYPT)
# ================================================

# Número de "salt rounds" para bcrypt (entre 10-12 recomendado)
BCRYPT_SALT_ROUNDS=10

# ============================================================
# ARCHIVOS DE PRUEBAS DE APIs (colecciones YAML/JSON)
# ============================================================
/sistema-reservacion-hoteles/
sistema-reservacion-hoteles/
*.bruno/
*.postman_collection.json
*.postman_environment.json
backend/test-models.js
backend/*.test.js
backend/**/*.test.js
backend/**/*.spec.js
frontend/**/*.test.*
frontend/**/*.spec.*
/coverage/

# ============================================================
# HIGIENE DE GIT (TRAE WORKSPACE / MICROSERVICIOS)
# ============================================================
# Carpeta interna de TRAE (configuración workspace)
.trae/

# Microservicios en /services: ignorar node_modules y .env por servicio
services/*/node_modules/
services/*/.env
services/*/.env.*
# IMPORTANTE: Las PLANTILLAS .env.example SÍ se suben a Git (para los clones nuevos).
!services/*/.env.example

# Frontend (ya existían abajo, pero se mantienen aquí por claridad — las entradas
# originales en sección FRONTEND siguen siendo válidas y equivalentes):
#   frontend/.next/      → línea 38
#   frontend/node_modules/ → línea 34

# ============================================================
# BACKEND (Node.js / Express)
# ============================================================
backend/node_modules/
backend/.env
backend/.env.*
!backend/.env.example
backend/dist/
backend/build/
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*
backend/pnpm-debug.log*

# ============================================================
# FRONTEND (Next.js)
# ============================================================
frontend/node_modules/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
frontend/.turbo/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/.vercel

# ============================================================
# GENERALES / OS / EDITORES
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Logs
*.log
logs/

# Variables de entorno raíz
.env
.env.*
!.env.example

# ----------------------------------------------------------------
# CORRECCIÓN ORDEN .gitignore: DESBLOQUEAR services/*/.env.example
# ----------------------------------------------------------------
# Regla L89 ".env.*" (patrón global SIN prefijo /) aplica a TODO el
# repo e IGNORA services/*/.env.example. La negación L28 venía ANTES
# y no le gana al último match (principio "last matching rule wins"
# de Git).
#   → Volvemos a NEGAR (de-ignore) los templates de servicios AQUÍ,
#     DESPUÉS del patrón general, para tener la última palabra.
!services/*/.env.example
!backend/.env.example
!frontend/.env.example

# Dependencias
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Testing / Builds generales
/dist
/build
/.next
/out

# TypeScript
*.tsbuildinfo
